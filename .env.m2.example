# RiTech-NASDAQ100 — Máquina 2 (Nodo Central) — Plantilla de variables de entorno
# INSTRUCCIONES: copia a `.env` en M2, rellena los valores y deja el permiso en 600:
#     chmod 600 .env
# `.env` está en .gitignore y NUNCA se commitea. Ver `docs/despliegue.md` §4.
#
# M2 es el nodo maestro: ingesta, bases de datos, API y orquestación. Acumula
# la mayoría de los secretos del sistema, y por eso es la máquina que más
# cuidado merece. Ver también `.env.local` para lo que es de desarrollo.
#
# NO recibe: credenciales de entrenamiento de GPU ni la ruta del artefacto de
# inferencia — esas son de M1. M2 **consume** predicciones vía `INFERENCE_URL`,
# no las calcula.

# ---------------------------------------------------------------------------
# Credenciales en reposo (RNF-006 — AES-256)
# ---------------------------------------------------------------------------
# Clave maestra de 32 bytes en hex (64 caracteres) para `src/security/crypto.py`.
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
# En producción se inyecta como variable de entorno del servicio del SO (systemd
# `Environment=` o `LoadCredential=`), NO en este archivo junto a los secretos
# que ella misma descifra. En desarrollo la clave real vive en `.env.local`.
CREDENTIALS_MASTER_KEY=

# Secretos cifrados con AES-256-GCM. Generar cada uno con:
#   .venv/bin/python -m src.security.crypto encrypt "valor-en-claro"
# TWELVE_DATA_API_KEY_ENC: plan gratuito Basic — uso académico/personal
# (si fuera producción real requeriría plan comercial; ver CR-002).
TWELVE_DATA_API_KEY_ENC=
IB_API_KEY_ENC=
IB_ACCOUNT_ID_ENC=

# ---------------------------------------------------------------------------
# PostgreSQL 16 (docker-compose.yml) — retención mínima de 5 años
# ---------------------------------------------------------------------------
POSTGRES_DB=ritech
POSTGRES_USER=ritech
POSTGRES_PASSWORD=

# Host/puerto que usa `src/database/pg.py`. Por defecto 127.0.0.1:5432, que es
# lo que sirve en host porque el contenedor solo publica loopback. En
# docker-compose se sobrescribe a `PGHOST=postgres` (la abreviatura del servicio
# dentro de la red del compose): el .env NO cambia entre entornos (§15.1).
PGHOST=127.0.0.1
PGPORT=5432

# ---------------------------------------------------------------------------
# API de M2 (Sprint 3 Fase B + Sprint 4 Kill-Switch — src/endpoints)
# ---------------------------------------------------------------------------
# Las rutas GET siguen abiertas y sin autenticación (brecha declarada en
# CR-006, igual que en CR-004). Las únicas escrituras del API son las del
# Kill-Switch, y usa las mismas credenciales que el scheduler.
ENDPOINTS_HOST=127.0.0.1
ENDPOINTS_PORT=8010

# ---------------------------------------------------------------------------
# Kill-Switch (Sprint 4 — RF-501/502/503, CR-006)
# ---------------------------------------------------------------------------
# Hash de la CLAVE DE REINICIO. Nunca la clave en claro, nunca en el repo.
# Generarlo en M2 (pide la clave dos veces, sin ecoarla):
#
#     .venv/bin/python -m src.security.clave_reinicio
#
# y pegar la salida aquí (.env está gitignored). MIENTRAS ESTÉ VACÍO el
# reinicio queda DESHABILITADO (el endpoint contesta 503): el disparo sigue
# funcionando sin clave, porque RF-501 no la pide en una emergencia.
KILL_SWITCH_RESET_KEY_HASH=

# Límite de intentos fallidos de la clave y ventana (segundos) en la que
# cuentan. El contador vive en `kill_switch_state`, así que sobrevive a un
# reinicio del proceso; se limpia al reiniciar con éxito o al caducar la
# ventana.
KILL_SWITCH_MAX_ATTEMPTS=5
KILL_SWITCH_VENTANA_INTENTOS_S=900

# Archivo de auditoría pendiente (append-only, mejor esfuerzo): recibe el
# evento cuando PostgreSQL no está, y se vuelca al arrancar. Relativo al
# directorio de trabajo del servicio; dentro del contenedor conviene apuntarlo
# a un volumen montado para que sobreviva a un rebuild.
AUDITORIA_PENDIENTE_RUTA=logs/auditoria-pendiente.jsonl

# Símbolo con el que el gateway simulado etiqueta las posiciones (RF-601).
# El esquema `transactions` es de instrumento único: es una etiqueta, no una
# columna.
SIMBOLO=QQQ

# ---------------------------------------------------------------------------
# Notificaciones locales (SS-11 — SRS §5.4, CR-007)
# ---------------------------------------------------------------------------
# Nada de esto se guarda en el repositorio: credenciales y destinos solo
# aquí. Sin configurar, el sistema no notifica y no se queja.
#
# Correo SMTP real. Para la demo con Mailpit (perfil `dev` de compose):
#   SMTP_HABILITADO=true  SMTP_HOST=127.0.0.1  SMTP_PUERTO=1025
#   SMTP_SSL=false  SMTP_DE=ritech@localhost  SMTP_PARA=operador@localhost
# Interfaz de Mailpit: http://127.0.0.1:8025
# Arranque: docker compose --profile dev up -d mailpit
SMTP_HABILITADO=false
SMTP_HOST=
SMTP_PUERTO=587
SMTP_SSL=false
SMTP_DE=
SMTP_PARA=
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_TIMEOUT_S=5

# SMS SIMULADO: escribe en una bandeja local rotulado "simulado". No hay
# módem ni proveedor (brecha declarada en CR-007): NO envía nada a nadie.
SMS_SIMULADO_HABILITADO=false
SMS_RUTA_SALIDA=logs/sms-salida.jsonl

# ---------------------------------------------------------------------------
# Dashboard por Nginx (Fase B2.5 — servicio `web` de docker-compose.yml)
# ---------------------------------------------------------------------------
# Interfaz de escucha del Nginx en el puerto 8080 (red host): por defecto solo
# loopback, es decir, el panel se abre en la propia Máquina 2. Para que la
# estación de la operadora (M3) lo abra desde su navegador:
#
#     WEB_BIND=0.0.0.0 docker compose up -d web
#
# (además de abrir el puerto 8080/tcp en el firewall de M2 hacia la intranet,
# pasos en docs/despliegue.md). Valores válidos: 127.0.0.1 (defecto) y
# 0.0.0.0; una IP concreta de LAN también funciona pero el healthcheck del
# contenedor asume loopback.
WEB_BIND=127.0.0.1

# Intervalo de la vela (RF-101) y, con él, el retraso que el estado considera
# desactualizado: 2 intervalos = 600 s. Regla provisional documentada en
# docs/despliegue.md; no se ajusta contra datos de test.
INTERVALO_VELA_S=300

# Feriados NYSE, opcional, en formato YYYY-MM-DD separados por coma. Solo afecta
# a la regla de estado: con la lista puesta, "hoy es feriado" se distingue de
# "hoy no llegan datos". Sin la lista, el caso desconocido muestra
# "sin datos en horario de mercado" (decisión de la corrección de estado).
FERIADOS_NYSE=2026-11-26,2026-12-25


# ---------------------------------------------------------------------------
# InfluxDB 2.7 (docker-compose.yml)
# ---------------------------------------------------------------------------
# `INFLUXDB_ADMIN_TOKEN` es el que usa el propio InfluxDB al arrancar. Es el
# que conviene aquí porque M2 escribe la serie temporal completa.
INFLUXDB_ORG=ritech
INFLUXDB_BUCKET=nasdaq_ticks
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_ADMIN_TOKEN=

# Si además se quisiera usar el nombre genérico (por ejemplo para que un
# proceso hijo no herede el token de administración), se define aparte. El
# código acepta los dos y prefiere este si está presente.
INFLUXDB_TOKEN=

# Dirección del InfluxDB **local**. Loopback porque el contenedor solo está
# publicado en 127.0.0.1 (verificado en el cierre del Sprint 2).
INFLUXDB_URL=http://127.0.0.1:8086

# ---------------------------------------------------------------------------
# Cliente de inferencia (`src/ai/client.py`) — RF-801, Sprint 3
# ---------------------------------------------------------------------------
# Dónde está el servicio de la Máquina 1. En desarrollo apunta a localhost;
# en despliegue, a la IP interna de M1. **La URL sale de aquí y no del
# código** (§15.1): cambiar de entorno no requiere tocar código.
#
# Este cliente NO necesita torch: M2 puede pedir predicciones sin instalar el
# grupo `ai`. Verificado por test (`tests/test_client.py::TestSinTorch`).
INFERENCE_URL=http://127.0.0.1:8000
INFERENCE_TIMEOUT_S=5

# ---------------------------------------------------------------------------
# Backfill de histórico (Sprint 3, RF-301)
# ---------------------------------------------------------------------------
# Sesiones bursátiles a ingerir con `python -m src.ingestion.backfill`.
# NO son días de calendario: 500 sesiones ≈ 2 años ≈ 40.000 velas ≈ 8
# peticiones de 5000 al plan Basic (1 crédito c/u, límite 8/min y 800/día).
BACKFILL_DAYS=500
