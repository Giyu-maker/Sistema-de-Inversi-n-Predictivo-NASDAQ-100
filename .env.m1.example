# RiTech-NASDAQ100 — Máquina 1 (Nodo IA) — Plantilla de variables de entorno
# INSTRUCCIONES: copia a `.env` en M1, rellena los valores y deja el permiso en 600:
#     chmod 600 .env
# `.env` está en .gitignore y NUNCA se commitea. Ver `docs/despliegue.md` §4.
#
# MÍNIMO PRIVILEGIO (§15.2). M1 entrena y sirve predicciones. **No recibe**:
#   - la API key de Twelve Data  (la ingesta es de M2)
#   - credenciales de PostgreSQL (M1 no escribe en la base, RF-301/§15)
#   - credenciales de Interactive Brokers (la ejecución es de M2)
#   - la clave maestra de criptografía (no tiene secretos que descifrar)
# Si alguna de esas variables aparece en este archivo, alguien se equivocó de
# máquina.

# ---------------------------------------------------------------------------
# Servicio de inferencia (`python -m src.ai.serve`) — RF-801
# ---------------------------------------------------------------------------
# De dónde carga el modelo. Puede ser el archivo `.pt` suelto o el directorio
# que contiene `active.json` (lo escribe `src.ai.train` tras cada
# reentrenamiento). Con el directorio, el timer diario deja un modelo nuevo y
# basta reiniciar el servicio: no hay que reconfigurar nada.
MODEL_PATH=/opt/ritech/models

# Interfaz de escucha. Por defecto solo loopback: el servicio habla con la
# Máquina 2 de la intranet y no tiene por qué ser visible desde fuera de M1.
# Para que M2 pueda alcanzarlo hay que poner la IP interna de esta máquina.
INFERENCE_HOST=127.0.0.1
INFERENCE_PORT=8000

# Arquitectura que queda activa tras cada reentrenamiento: `mlp` o `linear`.
# Ambas se entrenan y se guardan siempre; esto solo decide cuál puntea
# `active.json`. El default es `mlp` porque el SRS §5.3 exige una red
# neuronal — no porque gane: en el Sprint 3 el lineal igualó o superó al MLP
# y la diferencia no alcanzó significancia estadística. Ver informe §10.1.
MODEL_ARCH=mlp

# ---------------------------------------------------------------------------
# InfluxDB 2.7 — SOLO LECTURA, acotada al bucket (§15.2)
# ---------------------------------------------------------------------------
# M1 necesita leer las velas para entrenar, y nada más. El token debe ser de
# solo lectura y acotado a `nasdaq_ticks`; si tiene permisos de escritura o
# alcanza otros buckets, se está dando de más.
#
# La dirección por defecto es loopback. **El paso por la intranet es opt-in**:
# solo se cambia si se ha decidido explícitamente que M1 lea a M2 por red
# (ver `docs/despliegue.md` §5, incluida la limitación de RNF-005: HTTP sin
# TLS dentro de la red académica).
INFLUXDB_URL=http://127.0.0.1:8086
INFLUXDB_ORG=ritech
INFLUXDB_BUCKET=nasdaq_ticks

# Token de solo lectura acotado al bucket. Generarlo en M2 con
# `influx auth create --read-bucket --org ritech` y copiar el valor aquí.
# `INFLUXDB_ADMIN_TOKEN` existe como respaldo del entorno de desarrollo de M2;
# **no debe usarse en M1**: es el token de administración y da de más.
INFLUXDB_TOKEN=
