# RiTech-NASDAQ100 — Máquina 2 (Nodo Central) — Plantilla de variables de entorno
# INSTRUCCIONES: copia a `.env` en M2, rellena los valores y deja el permiso en 600:
#     chmod 600 .env
# `.env` está en .gitignore y NUNCA se commitea. Ver `docs/despliegue.md` §4.
#
# M2 es el nodo maestro: ingesta, bases de datos, API y orquestación. Acumula
# la mayoría de los secretos del sistema, y por eso es la máquina que más
# cuidado merece. Ver también `.env.local` para lo que es de desarrollo.
#
# NO recibe: credenciales de entrenamiento de GPU ni la ruta del artefacto de
# inferencia — esas son de M1. M2 **consume** predicciones vía `INFERENCE_URL`,
# no las calcula.

# ---------------------------------------------------------------------------
# Credenciales en reposo (RNF-006 — AES-256)
# ---------------------------------------------------------------------------
# Clave maestra de 32 bytes en hex (64 caracteres) para `src/security/crypto.py`.
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
# En producción se inyecta como variable de entorno del servicio del SO (systemd
# `Environment=` o `LoadCredential=`), NO en este archivo junto a los secretos
# que ella misma descifra. En desarrollo la clave real vive en `.env.local`.
CREDENTIALS_MASTER_KEY=

# Secretos cifrados con AES-256-GCM. Generar cada uno con:
#   .venv/bin/python -m src.security.crypto encrypt "valor-en-claro"
# TWELVE_DATA_API_KEY_ENC: plan gratuito Basic — uso académico/personal
# (si fuera producción real requeriría plan comercial; ver CR-002).
TWELVE_DATA_API_KEY_ENC=
IB_API_KEY_ENC=
IB_ACCOUNT_ID_ENC=

# ---------------------------------------------------------------------------
# PostgreSQL 16 (docker-compose.yml) — retención mínima de 5 años
# ---------------------------------------------------------------------------
POSTGRES_DB=ritech
POSTGRES_USER=ritech
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# InfluxDB 2.7 (docker-compose.yml)
# ---------------------------------------------------------------------------
# `INFLUXDB_ADMIN_TOKEN` es el que usa el propio InfluxDB al arrancar. Es el
# que conviene aquí porque M2 escribe la serie temporal completa.
INFLUXDB_ORG=ritech
INFLUXDB_BUCKET=nasdaq_ticks
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_ADMIN_TOKEN=

# Si además se quisiera usar el nombre genérico (por ejemplo para que un
# proceso hijo no herede el token de administración), se define aparte. El
# código acepta los dos y prefiere este si está presente.
INFLUXDB_TOKEN=

# Dirección del InfluxDB **local**. Loopback porque el contenedor solo está
# publicado en 127.0.0.1 (verificado en el cierre del Sprint 2).
INFLUXDB_URL=http://127.0.0.1:8086

# ---------------------------------------------------------------------------
# Cliente de inferencia (`src/ai/client.py`) — RF-801, Sprint 3
# ---------------------------------------------------------------------------
# Dónde está el servicio de la Máquina 1. En desarrollo apunta a localhost;
# en despliegue, a la IP interna de M1. **La URL sale de aquí y no del
# código** (§15.1): cambiar de entorno no requiere tocar código.
#
# Este cliente NO necesita torch: M2 puede pedir predicciones sin instalar el
# grupo `ai`. Verificado por test (`tests/test_client.py::TestSinTorch`).
INFERENCE_URL=http://127.0.0.1:8000
INFERENCE_TIMEOUT_S=5

# ---------------------------------------------------------------------------
# Backfill de histórico (Sprint 3, RF-301)
# ---------------------------------------------------------------------------
# Sesiones bursátiles a ingerir con `python -m src.ingestion.backfill`.
# NO son días de calendario: 500 sesiones ≈ 2 años ≈ 40.000 velas ≈ 8
# peticiones de 5000 al plan Basic (1 crédito c/u, límite 8/min y 800/día).
BACKFILL_DAYS=500
