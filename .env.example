# RiTech-NASDAQ100 — Plantilla de variables de entorno (Sprint 2)
# INSTRUCCIONES: copia este archivo a `.env` y rellena los valores.
# `.env` está en .gitignore y NUNCA se commitea.

# ---------------------------------------------------------------------------
# Credenciales en reposo (RNF-006 — AES-256)
# ---------------------------------------------------------------------------
# Clave maestra de 32 bytes en hex (64 caracteres) para crypto.py.
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
# En la Máquina 2 se inyecta como variable de entorno del servicio del SO;
# NO guardarla en este mismo archivo junto a los secretos cifrados.
CREDENTIALS_MASTER_KEY=

# Secretos cifrados con AES-256-GCM. Generar cada uno con:
#   .venv/bin/python -m src.security.crypto encrypt "valor-en-claro"
ALPHAVANTAGE_API_KEY_ENC=
IB_API_KEY_ENC=
IB_ACCOUNT_ID_ENC=

# ---------------------------------------------------------------------------
# PostgreSQL 16 (docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_DB=ritech
POSTGRES_USER=ritech
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# InfluxDB 2.7 (docker-compose.yml)
# ---------------------------------------------------------------------------
INFLUXDB_ORG=ritech
INFLUXDB_BUCKET=nasdaq_ticks
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_ADMIN_TOKEN=
