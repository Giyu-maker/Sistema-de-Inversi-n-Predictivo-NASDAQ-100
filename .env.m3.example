# RiTech-NASDAQ100 — Máquina 3 (Estación Operador) — Plantilla de variables de entorno
# INSTRUCCIONES: copia a `.env` en M3, rellena los valores y deja el permiso en 600:
#     chmod 600 .env
# `.env` está en .gitignore y NUNCA se commitea. Ver `docs/despliegue.md` §4.
#
# M3 es la terminal del operador y del gerente: corre el dashboard React y, en
# el Sprint 4, el botón del Kill-switch. **Es la máquina que menos secretos
# debe tener**, y ahora mismo no necesita ninguno del backend.
#
# El dashboard no habla con la Máquina 1. Habla con la API de M2 (Fase B del
# Sprint 3), y es M2 quien a su vez llama a M1. Dejar a M3 apuntando directo
# al servicio de inferencia haría dos cosas mal: expondría el modelo a la
# estación de operación y duplicaría la lógica de negocio que vive en M2.

# ---------------------------------------------------------------------------
# API del backend (Máquina 2) — Fase B del Sprint 3
# ---------------------------------------------------------------------------
# Se usa cuando la API de M2 para el dashboard esté lista. En la Fase A esta
# variable no la consume ningún componente.
API_URL=http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# Credenciales del operador
# ---------------------------------------------------------------------------
# El login es contra `trader_users` (PostgreSQL en M2), con hash Bcrypt y OTP
# TOTP para el Modo Autónomo. M3 **no** guarda credenciales de base de datos:
# solo el token de sesión del usuario, que es un asunto del navegador.
# Ver `docs/sdd.md` §3.1.1.
#
# El único secreto que esta máquina debería llegar a tener es el del canal de
# notificaciones, y solo si en el Sprint 4 se decide que las alertas SMS/SMTP
# salgan desde aquí y no desde M2.
NOTIFICATIONS_ENABLED=false
